# Base URL of the deployed backend, INCLUDING the /api/v1 suffix, no trailing slash
# Local:      http://localhost:4000/api/v1
# Production: https://your-api.onrender.com/api/v1
REACT_APP_BASE_URL=http://localhost:4000/api/v1

# Razorpay PUBLIC key id (rzp_test_... or rzp_live_...). Never put the secret here.
REACT_APP_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
