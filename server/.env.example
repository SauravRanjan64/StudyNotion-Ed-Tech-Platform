# ---------- Server ----------
PORT=4000
NODE_ENV=development            # set to "production" when deployed

# Frontend origin(s) allowed by CORS and used in email links.
# Comma-separated for several; first one is used in emails. No trailing slash.
# e.g. https://your-site.netlify.app   or   https://your-site.netlify.app,http://localhost:3000
CLIENT_URL=http://localhost:3000

# ---------- Database (MongoDB Atlas) ----------
# Local: mongodb://127.0.0.1:27017/studynotion
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studynotion
MONGODB_URL=mongodb://127.0.0.1:27017/studynotion

# ---------- Auth ----------
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ---------- Cloudinary (media uploads) - optional locally ----------
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=StudyNotion         # Cloudinary folder for uploads

# ---------- Razorpay (payments) - optional locally ----------
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=

# ---------- Email: choose ONE option ----------
# Option A (recommended on free hosts that block SMTP, e.g. Render free): Brevo HTTP API
BREVO_API_KEY=
MAIL_FROM_EMAIL=                # must be a verified sender in Brevo
MAIL_FROM_NAME=StudyNotion

# Option B: plain SMTP (leave BREVO_API_KEY empty). Gmail example with an App Password:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=StudyNotion <you@example.com>

# ---------- Seed script (npm run seed) - optional ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
